    def get_data_nascimento(self):
        return self.__data_nascimento

    def get_matricula_ativa(self):
        return self.__matricula_ativa

    def set_matricula_ativa(self, status: bool):
        self.__matricula_ativa = status

    def get_plano(self):
        return self.__plano

    def set_plano(self, novo_plano: Plano):
        self.__plano = novo_plano

    def atualizar_dados(self, telefone: str = None,
                        matricula_ativa: bool = None,
                        plano: Plano = None):
        if telefone:
            self.__telefone = telefone

        if matricula_ativa is not None:
            self.__matricula_ativa = matricula_ativa

        if plano:
            self.__plano = plano

    def verificar_matricula(self) -> bool:
        return self.__matricula_ativa

    def adicionar_treino(self, treino: Treino):
        # impacto: impede que o mesmo treino seja associado duas vezes ao aluno.
        if treino in self.__treinos:
            return

        # impacto: evita que um treino já vinculado a outro aluno seja reutilizado.
        if treino.get_aluno() is not None and treino.get_aluno() is not self:
            raise ValueError("Treino já vinculado a outro aluno.")

        # impacto: registra a associação nas duas classes.
        treino.definir_aluno(self)
        self.__treinos.append(treino)

    def listar_treinos(self) -> list:
        # impacto: fornece os treinos para a tela de consulta dos alunos.
        return self.__treinos
